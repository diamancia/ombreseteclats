# Copier ce fichier vers .env et renseigner les valeurs (jamais commit .env réel).

# --- Base de données (Supabase / Postgres — src/lib/db/*) ---
# Dashboard Supabase > Project Settings > API : "Project URL" et "service_role" (secret,
# bypass RLS — jamais exposée côté client, jamais préfixée NEXT_PUBLIC_).
# Appliquer supabase/migrations/0001_init.sql sur le projet avant de brancher le code dessus.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth admin (JWT) ---
# Générer une valeur aléatoire, ex: openssl rand -base64 32
JWT_SECRET=

# --- Stockage photos (Supabase Storage — src/lib/imageStorage.ts) ---
# Dashboard Supabase > Storage > créer un bucket PUBLIC nommé "product-images".
# Utilise les mêmes identifiants que SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY ci-dessus,
# aucune variable d'env supplémentaire nécessaire.

# --- Paiement (Stripe) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_KEY=

# --- Phase 1 : description produit par IA (Claude) ---
ANTHROPIC_API_KEY=

# --- Phase 2 : publication automatique Facebook/Instagram (Meta Graph API) ---
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_BUSINESS_ACCOUNT_ID=

# --- Phase 6 : notification Telegram des nouvelles commandes/demandes sur-mesure ---
# 1. Parler à @BotFather sur Telegram > /newbot > récupérer le token.
# 2. Envoyer un message au bot, puis ouvrir https://api.telegram.org/bot<TOKEN>/getUpdates
#    pour récupérer le "chat":{"id": ...} à mettre dans TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Phase 6 : carte Google Maps (page Contact) ---
# console.cloud.google.com > APIs & Services > activer "Maps Embed API" > Credentials
# > Create API key. Restreindre ensuite la clé par référent HTTP (votre domaine) dans
# les paramètres de la clé. Ne s'affiche que si Paramètres > Contact > Adresse est rempli.
GOOGLE_MAPS_API_KEY=

# --- Avis clients (section "Avis clients", page d'accueil) ---
# Même projet Google Cloud que GOOGLE_MAPS_API_KEY : activer en plus "Places API" (legacy)
# et créer une clé (ou réutiliser la même en l'autorisant pour Places API).
# GOOGLE_PLACE_ID : identifiant de la fiche Google Business Profile de la boutique —
# le trouver sur https://developers.google.com/maps/documentation/places/web-service/place-id
# en cherchant le nom de la boutique.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
