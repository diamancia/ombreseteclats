# Copier ce fichier vers .env et renseigner les valeurs (jamais commit .env réel).

# --- MongoDB (conteneur "mongodb-local" via docker, port 27017) ---
MONGODB_URI=mongodb://localhost:27017/ayara
MONGODB_DB=ayara

# --- Auth admin (JWT) ---
# Générer une valeur aléatoire, ex: openssl rand -base64 32
JWT_SECRET=

# --- Stockage photos (Cloudflare R2, compatible S3) ---
# Dashboard Cloudflare > R2 > créer un bucket + un jeton API (Object Read & Write)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optionnel : URL publique du bucket (CDN). Si absent, les images passent par /api/files.
R2_PUBLIC_URL=

# --- Paiement (Stripe) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_KEY=

# --- Phase 1 : description produit par IA (Claude) ---
ANTHROPIC_API_KEY=

# --- Phase 2 : publication automatique Facebook/Instagram (Meta Graph API) ---
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_BUSINESS_ACCOUNT_ID=
